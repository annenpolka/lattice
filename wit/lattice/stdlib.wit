package lattice:stdlib@0.1.0;

interface lowering {
    record rational-time {
        num: s64,
        den: s64,
    }

    record span {
        start: u32,
        end: u32,
        line: u32,
        column: u32,
    }

    record time-map-segment {
        local-start: rational-time,
        local-duration: rational-time,
        content-start: rational-time,
        rate: rational-time,
    }

    record time-map {
        duration: rational-time,
        segments: list<time-map-segment>,
    }

    record placement-fragment {
        start: rational-time,
        duration: rational-time,
        text: string,
        opacity: option<u8>,
        span: span,
    }

    /// Insert a rate-0 hold. Returns the updated TimeMap. No FFmpeg / GPUI.
    freeze: func(map: time-map, at: rational-time, hold: rational-time) -> result<time-map, string>;

    /// Build a title placement fragment. No FFmpeg / GPUI.
    title: func(text: string, at: rational-time, hold: rational-time, opacity: option<u8>, span: span) -> result<placement-fragment, string>;

    /// Build a caption cue fragment. Timing merge stays on the host.
    /// Lowers onto the existing title overlay. No FFmpeg / GPUI / karaoke.
    caption: func(text: string, at: rational-time, hold: rational-time, opacity: option<u8>, span: span) -> result<placement-fragment, string>;

    /// Build a callout placement fragment. Style parsing stays on the host.
    callout: func(text: string, at: rational-time, hold: rational-time, span: span) -> result<placement-fragment, string>;

    /// Validate and return a fade-in duration fragment.
    fade: func(hold: rational-time) -> result<rational-time, string>;

    /// Validate an explicit empty interval in sequence flow.
    gap: func(hold: rational-time) -> result<rational-time, string>;

    /// Validate and narrow a gain value to Core's dB representation.
    gain: func(db: s64) -> result<s32, string>;

    record speech-fragment {
        start: rational-time,
        duration: rational-time,
        text: string,
        media-name: string,
        span: span,
    }

    /// Build generated speech intent. Provider I/O remains outside Compile.
    speech: func(text: string, at: rational-time, hold: rational-time, span: span) -> result<speech-fragment, string>;

    /// Title overlay style fields only. No position / scale / anchor.
    record overlay-style {
        color: option<string>,
        size-milli: option<u16>,
        size-px: option<u32>,
        weight: option<u16>,
        family: option<string>,
        bar: option<string>,
        align: option<string>,
    }

    /// Guest-provided title presets. Host registers these at stdlib init.
    overlay-presets: func() -> list<tuple<string, overlay-style>>;
}

world stdlib {
    export lowering;
}
