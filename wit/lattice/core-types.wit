package lattice:core@0.1.0;

interface types {
    record rational-time {
        num: s64,
        den: s64,
    }

    record span {
        start: u32,
        end: u32,
        line: u32,
        column: u32,
    }

    record time-span {
        start: rational-time,
        duration: rational-time,
    }
}
