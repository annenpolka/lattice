package lattice:dsl@0.1.0;

interface lowering {
    use lattice:core/types.{rational-time, span};

    record invocation {
        command: string,
        span: span,
    }

    /// Provisional v0 spelling. The hosted contract is `lattice:stdlib/lowering`
    /// (`freeze` / `title` functions) in `stdlib.wit`.
    lower: func(command: string) -> result<string, string>;
}
